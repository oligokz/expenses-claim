# Copy to .env.local for `vercel dev`, and set the same names in the Vercel
# project (Settings > Environment Variables). Never commit real values.

# ── Microsoft Entra app registration ──
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# The app that calls Graph with application permissions
# (Sites.ReadWrite.All, Mail.Send scoped to MAIL_SENDER by an access policy).
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
# The SPA's client id, used to check the audience of the user's token.
# Must match AUTH.clientId in src/lib/constants.ts.
SPA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Optional, defaults to api://<SPA_CLIENT_ID>.
API_AUDIENCE=

# ── SharePoint ──
SP_SITE_URL=https://yourtenant.sharepoint.com/sites/Forms
# Document library that holds every attachment, signature and signed PDF.
SP_LIBRARY_NAME=Documents
# Expense claims list. Required, there is no default.
SP_LIST_NAME=ExpenseClaims
# The rest default to the names shown.
SP_LEAVE_LIST_NAME=Leave Requests
SP_LEAVETYPES_LIST_NAME=Leave Types
SP_REQUISITION_LIST_NAME=Purchase Requisitions
SP_REQCATEGORIES_LIST_NAME=Requisition Categories
SP_TRAVEL_LIST_NAME=Travel Requests
# The approver roster, used by every module.
SP_REQAPPROVERS_LIST_NAME=Requisition Approvers

# ── Mail and links ──
MAIL_SENDER=noreply@yourdomain.com
# Public URL of the app, used in every link in an email. No trailing slash.
APP_BASE_URL=https://app.yourdomain.com
# Comma-separated addresses copied when a request is fully approved. Blank = nobody.
NOTIFY_ON_APPROVED=

# ── Security ──
# Comma-separated origins allowed to call /api from a browser.
ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com
# Signs approval links. If unset, a key is derived from AZURE_CLIENT_SECRET,
# and rotating that secret invalidates every outstanding approval link.
APPROVAL_TOKEN_SECRET=
# Testing only: lets a requester name themselves as approver.
ALLOW_SELF_APPROVAL=false
